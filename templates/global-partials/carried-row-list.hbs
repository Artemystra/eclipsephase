{{!-- A character's consumables or gear, one row each, laid out like the armour rows: Move before the name on a body, Put into Stash or Equip on the right. --}}
{{#each item as |item id|}}
    <div class="item flexrow flex-group-center offHand reveal ep-carried-row" data-item-id="{{item._id}}" data-item-name="{{item.name}}">
        <div class="ep-carried-lead">
            <div style="max-width: 25px!important;">
                <div class="noShow toggle" style="padding-left: 4px;">
                    <a class="item-drag flexrow flex-group-left input-small" data-itemid="{{item.id}}" draggable="true" data-action="dragItem" title="Drag item">
                        <i class="fas fa-bars" style="text-align: left; font-size: 18px;"></i>
                    </a>
                </div>
                <div class="item-image flex-group-center input-small toggle"><img src="{{item.img}}" title="{{item.name}}" width="24" height="24"/></div>
            </div>
            {{> systems/eclipsephase/templates/global-partials/carried-controls.hbs item=item place=../place part="lead"}}
        </div>
        <span class="wantToKnowMoreFixed ep-name-tip" style="flex: 3.5;"><label class="truncate alignLeft"><strong>{{item.name}}</strong></label><span class="tooltipText">{{item.name}}</span></span>
        <label class="flex-group-center alignCenter" style="background: none; font-size: 12px; flex: 0.4; margin-left: 10px;"><i>{{localize item.system.slotName}}</i></label>
        <input class="input-small sheet-inline-edit" data-field="system.quantity" type="number" name="item.system.quantity" value="{{item.system.quantity}}" placeholder="0"/>
        <div class="ep-row-icons">
            {{> systems/eclipsephase/templates/global-partials/carried-controls.hbs item=item place=../place part="end"}}
            <a class="item-control item-delete resource-label editWithLabel" title="Delete Item"><i class="far fa-times-circle awesomeIcon"></i></a>
            <a class="item-control item-edit resource-label editWithLabel" title="Edit Item"><i class="far fa-edit awesomeIcon"></i></a>
            <div class="slideShow">
                <a class="showFlex"><i class="fas fa-plus icon-xsmall awesomeIcon"></i></a>
                <a class="noShow"><i class="fas fa-minus icon-xsmall awesomeIcon"></i></a>
            </div>
        </div>
        <div class="item showMore descriptionContainer ep-item-details">
            <div class="itemDescription" style="min-width: 100%;">
                {{{item.system.description}}}
            </div>
        </div>
    </div>
{{/each}}
