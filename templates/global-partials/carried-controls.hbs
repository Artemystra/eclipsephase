{{!-- Where a character's carried item can go from its row. part "lead" sits before the name: Move to another body, for an item on a body. part "end" sits on the right: Put into Stash on a body, Equip in the Stash. --}}
{{#if (eq part "lead")}}
{{#if (eq place "body")}}
<a class="item-control item-rebind input-small wantToKnowMore" data-item-id="{{item._id}}">
    <i class="fa-solid fa-right-left awesomeIcon"></i>
    <span class="tooltipText">{{localize 'ep2e.actorSheet.button.rebindItem'}}</span>
</a>
{{/if}}
{{else if (eq place "stash")}}
<a class="item-control item-equip input-small wantToKnowMore tooltip-opens-left" data-item-id="{{item._id}}">
    <i class="fa-regular fa-circle-up awesomeIcon" style="color: var(--iconBlue);"></i>
    <span class="tooltipText">{{localize 'ep2e.actorSheet.button.equipItem'}}</span>
</a>
{{else if (eq place "body")}}
<a class="item-control item-stash input-small wantToKnowMore tooltip-opens-left" data-item-id="{{item._id}}">
    <i class="fa-solid fa-box-archive awesomeIcon"></i>
    <span class="tooltipText">{{localize 'ep2e.actorSheet.button.stashItem'}}</span>
</a>
{{/if}}
