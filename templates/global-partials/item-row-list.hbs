{{#each item as |item id|}}
    <div class="item flexrow offHand flex-group-center wantToKnowMore item-row-list-entry" data-item-id="{{item._id}}" data-item-name="{{item.name}}">
        <label class="tooltipText" style="min-width: 190px; left: -5px">{{item.name}}</label>
        {{#if ../selectable}}
        {{!-- id, not just class - lets core's focus-restore find it back after a re-render --}}
        <input type="checkbox" id="purchase-select-{{item._id}}" class="item-purchase-select" data-item-id="{{item._id}}" {{checked (lookup ../selected item._id)}}/>
        {{/if}}
        {{#if item.system.canTakeDose}}
        <div class="item-image flex-group-left input-small item-image-zoomable drug-use" data-item-id="{{item._id}}">
            <img src="{{item.img}}" alt="{{item.name}}" width="24" height="24"/>
            <i class="fas fa-syringe item-image-zoom-icon"></i>
        </div>
        {{else if item.system.canThrow}}
        <div class="item-image flex-group-left input-small item-image-zoomable task-check" data-type="skill" data-key="athletics" data-name="{{localize 'ep2e.skills.vigorSkills.athletics'}}" data-rolledfrom="grenade" data-weaponid="{{item._id}}">
            <img src="{{item.img}}" alt="{{item.name}}" width="24" height="24"/>
            <i class="fas fa-bomb item-image-zoom-icon"></i>
        </div>
        {{else}}
        <div class="item-image flex-group-left input-small"><img src="{{item.img}}" alt="{{item.name}}" width="24" height="24"/></div>
        {{/if}}
        <label class="truncate alignLeft" style="flex: 3.5;"><strong>{{item.name}}</strong></label>
        {{#if item.system.slotName}}
        <label class="flex-group-center alignCenter" style="background: none; font-size: 12px; flex: 0.4; margin-left: 10px;"><i>{{localize item.system.slotName}}</i></label>
        {{/if}}
        {{#if item.shopComplexityLabel}}
        <label class="flex-group-center alignCenter" style="background: none; font-size: 12px; width: 70px;">{{localize item.shopComplexityLabel}}</label>
        {{/if}}
        {{#if item.system.quantity}}
        {{#unless ../hideQuantity}}
        {{#if item.system.canTakeDose}}
        <label class="flex-group-center alignCenter" style="background: none; margin-left: 10px;" data-tooltip="{{localize 'ep2e.item.drug.dosesLeft'}}">{{item.system.dosesLeft}}</label>
        {{else}}
        <label class="flex-group-center alignCenter" style="background: none; margin-left: 10px;">{{item.system.quantity}}</label>
        {{/if}}
        {{/unless}}
        {{/if}}
        <div class="flexrow item-controls flex-group-right" style="max-width: 50px; min-width: 50px;">
            {{#unless ../readOnly}}
            <a class="item-control item-delete resource-label editWithLabel input-xs alignRight" title="Delete Item"><i class="far fa-times-circle awesomeIcon"></i></a>
            {{/unless}}
            {{!-- Same .item-edit class either way - the click handler just opens item.sheet; whether
                 that sheet ends up editable is decided by the item's own permission, not this icon. --}}
            <a class="item-control item-edit resource-label editWithLabel  input-xs alignRight"{{#if ../readOnly}} data-view-only="true"{{/if}}><i class="far fa-{{#if ../readOnly}}eye{{else}}edit{{/if}} awesomeIcon"></i></a>
        </div>
        <div class="flex-group-right slideShow input-xs">
            <a class="showFlex"><i class="fas fa-plus icon-xsmall awesomeIcon"></i></a>
            <a class="noShow"><i class="fas fa-minus icon-xsmall awesomeIcon"></i></a>
        </div>
        {{#if item.system.description}}
        <div class="item showMore descriptionContainer">
            <div class="itemDescription" style="min-width: 100%;">
                {{{item.system.description}}}
            </div>
        </div>
        {{/if}}
    </div>
{{/each}}
