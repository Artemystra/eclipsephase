{{#each item as |item id|}}
    <div class="item flexrow flex-group-center atHand reveal" data-item-id="{{item._id}}" data-item-name="{{item.name}}">
        <div style="max-width: 25px!important;">
            <div class="noShow toggle" style="padding-left: 4px;">
                <a class="item-drag flexrow flex-group-left input-small" data-itemid="{{item.id}}" draggable="true" data-action="dragItem" title="Drag item">
                    <i class="fas fa-bars" style="text-align: left; font-size: 18px;"></i>
                </a>
            </div>
            <div class="item-image flex-group-center input-small toggle"><img src="{{item.img}}" title="{{item.name}}" width="24" height="24"/></div>
        </div>
        <label class="truncate alignLeft" style="flex: 3.5; font-weight: bold;">{{item.name}}</label>
        <img src="systems/eclipsephase/resources/icons/power.webp" class="icon-small"/>
        <label class="labelWidth-small flex-group-center noMargin"><strong>{{item.system.energy}}</strong></label>
        <img src="systems/eclipsephase/resources/icons/shield.webp" class="icon-small" style="max-height: 24px!important; max-width: 20px!important;"/>
        <label class="labelWidth-small flex-group-center noMargin"><strong>{{item.system.kinetic}}</strong></label>
        <label class="labelWidth-XL flex-group-center noMargin"><strong>{{localize item.system.slotName}}</strong></label>
        {{#unless ../readOnly}}
        <div class="flexrow item-controls flex-group-right" style="max-width: 50px; min-width: 50px;">
            <a class="item-control item-delete resource-label editWithLabel input-xs alignRight" title="Delete Item"><i class="far fa-times-circle awesomeIcon"></i></a>
            <a class="item-control item-edit resource-label editWithLabel input-xs alignRight" title="Edit Item"><i class="far fa-edit awesomeIcon"></i></a>
        </div>
        {{/unless}}
        {{#if item.system.description}}
        <div class="flex-group-right slideShow input-xs">
            <a class="showFlex"><i class="fas fa-plus icon-xsmall awesomeIcon"></i></a>
            <a class="noShow"><i class="fas fa-minus icon-xsmall awesomeIcon"></i></a>
        </div>
        {{else}}
        <div class="flex-group-right slideShow input-xs icon-hidden">
            <a class="showFlex"><i class="fas fa-plus icon-xsmall awesomeIcon"></i></a>
            <a class="noShow"><i class="fas fa-minus icon-xsmall awesomeIcon"></i></a>
        </div>
        {{/if}}
        <div class="item showMore descriptionContainer" style="min-width: 100%;">
            <div class="itemDescription" style="min-width: 100%;">
                {{{item.system.description}}}
            </div>
        </div>
    </div>
{{/each}}
