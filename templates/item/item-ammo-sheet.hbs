<form class="{{cssClass}}" autocomplete="off">
    {{> systems/eclipsephase/templates/item/partials/sheet-titlebar.hbs}}
    {{> systems/eclipsephase/templates/item/partials/sheet-tabs.hbs}}

    <section class="item-sheet-body">
        <div class="tab {{#if (eq tabGroups.primary 'details')}}active{{/if}}" data-group="primary" data-tab="details">
{{#if (eq item.system.type "seeker")}}
<div class="flexrow subheader">
    <h3 class="subheader dialog">{{localize "ep2e.item.weapon.table.section.general"}}</h3>
</div>
<div class="ep-sheet-grid ep-sheet-grid-4">
<label class="ep-field">
    <span class="resource-label">{{localize "ep2e.item.weapon.table.armorUsed.label"}}</span>
    <select name="system.armorused" data-type="String">
        {{selectOptions config.grenadeArmorVector selected=item.system.armorused blank=(localize "ep2e.item.weapon.table.armorUsed.asWeapon") localize=true}}
    </select>
</label>
<label class="ep-field">
    <span class="resource-label">{{localize "ep2e.item.weapon.table.type.label"}}</span>
    <select name="system.type" data-type="String">
        {{selectOptions config.rangedAmmoType selected=item.system.type localize=true}}
    </select>
</label>
<label class="ep-field">
    <span class="resource-label">{{localize "ep2e.item.general.table.quantity"}}</span>
    <input onFocus="this.select()" type="number" name="system.quantity" value="{{item.system.quantity}}" placeholder="12"/>
</label>
{{> systems/eclipsephase/templates/item/partials/field-cost.hbs}}
</div>
{{> systems/eclipsephase/templates/item/partials/grenade-details.hbs}}
{{else}}
<div class="flexrow subheader">
    <h3 class="subheader dialog">{{localize "ep2e.item.weapon.table.section.general"}}</h3>
</div>
<div class="ep-sheet-grid ep-sheet-grid-3 munition-fields">
<label class="ep-field">
    <span class="resource-label">{{localize "ep2e.item.weapon.table.armorUsed.label"}}</span>
    <select name="system.armorused" data-type="String">
        {{selectOptions config.grenadeArmorVector selected=item.system.armorused blank=(localize "ep2e.item.weapon.table.armorUsed.asWeapon") localize=true}}
    </select>
</label>
<label class="ep-field">
    <span class="resource-label">{{localize "ep2e.item.weapon.table.type.label"}}</span>
    <select name="system.type" data-type="String">
        {{selectOptions config.rangedAmmoType selected=item.system.type localize=true}}
    </select>
</label>
{{#if (eq item.system.traits.noDamage.value true)}}
<div class="ep-field ep-field-bound">
    <span class="resource-label">{{localize "ep2e.item.weapon.table.damageValue"}}</span>
    <span>{{localize "ep2e.item.weapon.table.trait.noDamage"}}</span>
</div>
{{else if (eq item.system.traits.dvHalved.value true)}}
<div class="ep-field ep-field-bound">
    <span class="resource-label">{{localize "ep2e.item.weapon.table.damageValue"}}</span>
    <span>{{localize "ep2e.item.weapon.table.trait.dvHalved"}}</span>
</div>
{{else}}
{{> systems/eclipsephase/templates/item/partials/field-dice.hbs label="ep2e.item.weapon.table.damageValue" path="system.dv" values=item.system.dv}}
{{/if}}
<label class="ep-field">
    <span class="resource-label">{{localize "ep2e.item.general.table.quantity"}}</span>
    <input onFocus="this.select()" type="number" name="system.quantity" value="{{item.system.quantity}}" placeholder="12"/>
</label>
{{> systems/eclipsephase/templates/item/partials/field-cost.hbs}}
</div>
<div class="flexrow subheader">
    <h3 class="subheader dialog">{{localize "ep2e.item.weapon.table.payload.enabled"}}</h3>
</div>
{{> systems/eclipsephase/templates/item/partials/munition-payload.hbs columns=3}}
<div class="flexrow subheader">
    <h3 class="subheader dialog">{{localize "ep2e.item.weapon.table.section.traits"}}</h3>
</div>
{{> systems/eclipsephase/templates/item/partials/weapon-choice-pills.hbs choices=item.system.traits path="system.traits" placeholderKey="ep2e.item.weapon.table.addTrait"}}
{{/if}}
        </div>

        {{> systems/eclipsephase/templates/item/partials/sheet-description.hbs}}
        {{> systems/eclipsephase/templates/item/partials/sheet-effects.hbs}}
    </section>
</form>
