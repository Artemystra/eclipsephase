<form class="{{cssClass}}" autocomplete="off">
    <div class="ep-sheet-titlebar">
        <div class="ep-titlebar-item-logo">
            <img class="item-img" src="{{item.img}}" data-action="editImage" data-field="img" title="{{item.name}}"/>
        </div>
        <div class="ep-titlebar-name centerBackground">
            <input name="name" type="text" value="{{item.name}}" placeholder="Name" style="width: 100%;"/>
            <span class="ep-titlebar-name-plain">{{item.name}}</span>
        </div>
    </div>

    <nav class="sheet-tabs itemnav tabs" data-group="primary">
        {{#each tabs.primary as |tab|}}
            {{#if (eq tab.id "effects")}}
                {{#if @root.item.showEffectsTab}}
                    <a class="item {{#if tab.active}}active{{/if}}" data-action="tab" data-group="primary" data-tab="{{tab.id}}">
                        {{localize tab.label}}
                    </a>
                {{/if}}
            {{else}}
                <a class="item {{#if tab.active}}active{{/if}}" data-action="tab" data-group="primary" data-tab="{{tab.id}}">
                    {{localize tab.label}}
                </a>
            {{/if}}
        {{/each}}
    </nav>

    <section class="item-sheet-body" style="min-height: 240px; height: fit-content;">
        <div class="tab {{#if (eq tabGroups.primary 'details')}}active{{/if}}" data-group="primary" data-tab="details">
            <div class="item contentBox" data-item-id="{{item.id}}" data-item-name="{{item.name}}" style="padding-bottom: 5px;">
                <div class="flexrow">
                    <div class="alignRight flexGrowThreeQuarter">
                        <div class="flexrow alignCenter wantToKnowMore" style="margin-right: 10px;">
                            <i class="fa-regular fa-shield-halved awesomeIcon icon-small" style="max-width: fit-content;"></i>
                            <span class="tooltipText" style="font-size: 13px;">{{localize "ep2e.item.weapon.table.armorUsed.label"}}</span>
                            <select class="input-large" name="system.armorused" data-type="String">
                                {{selectOptions config.grenadeArmorVector selected=item.system.armorused localize=true}}
                            </select>
                        </div>
                    </div>
                </div>
            </div>
            {{> systems/eclipsephase/templates/item/partials/grenade-details.hbs item=item itemType="grenade"}}
        </div>

        <div class="tab {{#if (eq tabGroups.primary 'description')}}active{{/if}}" data-group="primary" data-tab="description">
            {{#if editable}}
                <prose-mirror
                    name="system.description"
                    button="true"
                    editable="true"
                    toggled="false"
                    value="{{item.system.description}}">
                    {{{htmlDescription}}}
                </prose-mirror>
            {{else}}
                {{{htmlDescription}}}
            {{/if}}
        </div>

        <div class="tab {{#if (eq tabGroups.primary 'effects')}}active{{/if}}" data-group="primary" data-tab="effects">
            {{> systems/eclipsephase/templates/actor/partials/tabs/gm-info-tab.html}}
        </div>
    </section>
</form>