<form class="{{cssClass}}" autocomplete="off">
    {{> systems/eclipsephase/templates/item/partials/sheet-titlebar.hbs}}
    {{> systems/eclipsephase/templates/item/partials/sheet-tabs.hbs}}

    <section class="item-sheet-body">
{{#if (eq item.system.chassisType "animal")}}
<div class="ep-sheet-strip ep-vehicle-aptitudes">
    {{#each item.system.aptitudes as |aptitude key|}}
    <div class="ep-strip-cell reveal">
        <div class="ep-rep-head">
            <span class="resource-label">{{localize aptitude.label}}</span>
            <label class="roll-label task-check noShow" data-type="aptitude" data-name="{{localize aptitude.name}}" data-key="item.system.aptitudes.{{key}}.value" data-apttype="{{key}}" data-rollvalue="{{aptitude.roll}}">
                <img src="icons/svg/d10-grey.svg" class="icon-small"/>
            </label>
        </div>
        <input onFocus="this.select()" type="number" name="system.aptitudes.{{key}}.value" value="{{aptitude.value}}" data-dtype="Number" placeholder="0"/>
    </div>
    {{/each}}
</div>
{{/if}}
        <div class="tab {{#if (eq tabGroups.primary 'details')}}active{{/if}}" data-group="primary" data-tab="details">
<div class="flexrow subheader">
    <h3 class="subheader dialog">{{localize "ep2e.item.weapon.table.section.general"}}</h3>
</div>
<div class="ep-sheet-grid ep-sheet-grid-4">
<label class="ep-field">
    <span class="resource-label">{{localize "ep2e.healthbar.tooltip.durdr"}}</span>
    <input onFocus="this.select()" type="number" name="system.dur" value="{{item.system.dur}}" placeholder="0"/>
</label>
<label class="ep-field">
    <span class="resource-label">{{localize "ep2e.item.vehicle.table.type.label"}}</span>
    <select name="system.chassisType" data-type="String">
        {{selectOptions config.vehicleType selected=item.system.chassisType localize=true}}
    </select>
</label>
{{> systems/eclipsephase/templates/item/partials/field-cost.hbs}}
<label class="ep-field">
    <span class="resource-label">{{localize "ep2e.item.vehicle.table.size.label"}}</span>
    <select name="system.slotType" data-type="String">
        {{selectOptions config.vehicleSize selected=item.system.slotType localize=true}}
    </select>
</label>
{{#if (eq item.system.chassisType "vehicle")}}
<label class="ep-field">
    <span class="resource-label">{{localize "ep2e.peripherals.table.passengers"}}</span>
    <input onFocus="this.select()" type="number" name="system.pass" value="{{item.system.pass}}" placeholder="0"/>
</label>
{{/if}}
{{#if (ne item.system.chassisType "animal")}}
<label class="ep-field">
    <span class="resource-label">{{localize "ep2e.item.armor.table.energy"}}</span>
    <input onFocus="this.select()" type="number" name="system.armor.energy" value="{{item.system.armor.energy}}" placeholder="0"/>
</label>
<label class="ep-field">
    <span class="resource-label">{{localize "ep2e.item.armor.table.kinetic"}}</span>
    <input onFocus="this.select()" type="number" name="system.armor.kinetic" value="{{item.system.armor.kinetic}}" placeholder="0"/>
</label>
{{/if}}
{{#if (eq item.system.chassisType "animal")}}
<label class="ep-field">
    <span class="resource-label">{{localize "ep2e.healthbar.tooltip.threat"}}</span>
    <input onFocus="this.select()" type="number" name="system.threat" value="{{item.system.threat}}" placeholder="0"/>
</label>
<label class="ep-field">
    <span class="resource-label">{{localize "ep2e.healthbar.tooltip.stressluc"}}</span>
    <input onFocus="this.select()" type="number" name="system.luc" value="{{item.system.luc}}" placeholder="0"/>
</label>
<label class="ep-field">
    <span class="resource-label">{{localize "ep2e.healthbar.tooltip.initiative"}}</span>
    <input onFocus="this.select()" type="number" name="system.init" value="{{item.system.init}}" placeholder="0"/>
</label>
{{/if}}
</div>
<div class="flexrow subheader">
    <h3 class="subheader dialog">{{localize "ep2e.item.morph.poolsHeadline"}}</h3>
</div>
<div class="ep-sheet-grid ep-sheet-grid-4">
<label class="ep-field">
    <span class="resource-label"><img src="systems/eclipsephase/resources/icons/insightBright.webp" class="icon-small"/> {{localize "ep2e.morph.currentMorph.insightLabel"}}</span>
    <input onFocus="this.select()" type="number" name="system.insight" value="{{item.system.insight}}" placeholder="0"/>
</label>
<label class="ep-field">
    <span class="resource-label"><img src="systems/eclipsephase/resources/icons/moxieBright.webp" class="icon-small"/> {{localize "ep2e.morph.currentMorph.moxieLabel"}}</span>
    <input onFocus="this.select()" type="number" name="system.moxie" value="{{item.system.moxie}}" placeholder="0"/>
</label>
<label class="ep-field">
    <span class="resource-label"><img src="systems/eclipsephase/resources/icons/vigorBright.webp" class="icon-small"/> {{localize "ep2e.morph.currentMorph.vigorLabel"}}</span>
    <input onFocus="this.select()" type="number" name="system.vigor" value="{{item.system.vigor}}" placeholder="0"/>
</label>
<label class="ep-field">
    <span class="resource-label"><img src="systems/eclipsephase/resources/icons/flexBright.webp" class="icon-small"/> {{localize "ep2e.morph.currentMorph.flexLabel"}}</span>
    <input onFocus="this.select()" type="number" name="system.flex" value="{{item.system.flex}}" placeholder="0"/>
</label>
</div>
{{> systems/eclipsephase/templates/item/partials/movement-grid.hbs}}
        </div>
        <div class="tab {{#if (eq tabGroups.primary 'aptitudes')}}active{{/if}}" data-group="primary" data-tab="aptitudes">
<div class="flexrow subheader">
    <h3 class="subheader dialog">{{#if (eq item.system.chassisType "animal")}}{{localize "ep2e.peripherals.skillsHeadline"}}{{else}}{{localize "ep2e.peripherals.aiSkillsHeadline"}}{{/if}}</h3>
    {{#if (ne item.system.chassisType "animal")}}
    <button type="button" class="autoBot ep-subheader-button" data-name="{{item.name}}" data-id="{{item.id}}">{{localize "ep2e.item.vehicle.autoBot"}}</button>
    {{/if}}
</div>
<div class="ep-sheet-grid ep-sheet-grid-4">
    <span class="resource-label ep-grid-heading ep-span-2">{{localize "ep2e.item.vehicle.table.skillName"}}</span>
    <span class="resource-label ep-grid-heading">{{localize "ep2e.item.additionalSkill.table.valueLabel"}}</span>
    <span class="resource-label ep-grid-heading">{{localize "ep2e.item.additionalSkill.table.specLabel"}}</span>
    {{#each item.system.skills as |skill key|}}
    <div class="ep-field ep-span-2"><input onFocus="this.select()" type="text" name="system.skills.{{key}}.name" value="{{skill.name}}"/></div>
    <div class="ep-field"><input onFocus="this.select()" type="number" name="system.skills.{{key}}.value" value="{{skill.value}}" data-dtype="Number" placeholder="0"/></div>
    <div class="ep-field"><input onFocus="this.select()" type="text" name="system.skills.{{key}}.specname" value="{{skill.specname}}"/></div>
    {{/each}}
</div>
        </div>
        <div class="tab {{#if (eq tabGroups.primary 'additions')}}active{{/if}}" data-group="primary" data-tab="additions">
{{> systems/eclipsephase/templates/item/partials/additions-tab.hbs}}
        </div>

        {{> systems/eclipsephase/templates/item/partials/sheet-description.hbs}}
        {{> systems/eclipsephase/templates/item/partials/sheet-effects.hbs}}
    </section>
</form>
