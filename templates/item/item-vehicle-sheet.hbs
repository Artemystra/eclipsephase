<form class="{{cssClass}}" autocomplete="off">
    <div class="ep-sheet-titlebar">
        <div class="ep-titlebar-item-logo">
            <img class="item-img" src="{{item.img}}" data-action="editImage" data-field="img" title="{{item.name}}"/>
        </div>
        <div class="ep-titlebar-name centerBackground">
            <input name="name" type="text" value="{{item.name}}" placeholder="Name" style="width: 100%;"/>
            <span class="ep-titlebar-name-plain">{{item.name}}</span>
        </div>
    </div>

    <nav class="sheet-tabs itemnav tabs" data-group="primary">
        {{#each tabs.primary as |tab|}}
            {{#if (eq tab.id "effects")}}
                {{#if @root.item.showEffectsTab}}
                    <a class="item {{#if tab.active}}active{{/if}}" data-action="tab" data-group="primary" data-tab="{{tab.id}}">
                        {{localize tab.label}}
                    </a>
                {{/if}}
            {{else}}
                <a class="item {{#if tab.active}}active{{/if}}" data-action="tab" data-group="primary" data-tab="{{tab.id}}">
                    {{localize tab.label}}
                </a>
            {{/if}}
        {{/each}}
    </nav>

    <section class="item-sheet-body" style="min-height: 245px; height: fit-content; overflow-y: scroll">
        <div class="tab {{#if (eq tabGroups.primary 'details')}}active{{/if}}" data-group="primary" data-tab="details">
            <div class="itemRowPadded" style="display: grid; grid-template-columns: repeat(3, 1fr); justify-items: start;">
                <div class="itemGroup">
                    <i class="fa-solid fa-heart-pulse awesomeIcon icon-small"></i>
                    <label class="resource-value">{{localize "ep2e.healthbar.tooltip.durdr"}}</label>
                    <input class="input-small" type="number" name="system.dur" value="{{item.system.dur}}" placeholder="0" style="text-align: center"/>
                </div>
                <div class="itemGroup">
                    <label class="resource-value">{{localize "ep2e.item.vehicle.table.type.label"}}</label>
                    <select style="max-width: 130px;" class="selectSpecApt" name="system.chassisType" data-type="String">
                        {{selectOptions config.vehicleType selected=item.system.chassisType localize=true}}
                    </select>
                </div>
                <div class="itemGroup">
                    <i class="fa-regular fa-money-bill awesomeIcon icon-small"></i>
                    <label class="resource-value">{{localize "ep2e.item.general.table.cost.label"}}</label>
                    <select name="system.cost" data-type="String">
                        {{selectOptions config.costTypes selected=item.system.cost localize=true}}
                    </select>
                </div>
            </div>

            <div class="itemRowPadded" style="display: grid; grid-template-columns: repeat(3, 1fr); justify-items: start;">
                <div class="itemGroup">
                    <i class="fa-regular fa-ruler awesomeIcon icon-small"></i>
                    <label class="resource-value">{{localize "ep2e.item.vehicle.table.size.label"}}</label>
                    <select name="system.slotType" data-type="String">
                        {{selectOptions config.vehicleSize selected=item.system.slotType localize=true}}
                    </select>
                </div>
                <div class="itemGroup">
                    {{#if (eq item.system.chassisType "vehicle")}}
                    <i class="fa-regular fa-seat-airline awesomeIcon icon-small"></i>
                    <label class="resource-value">{{localize "ep2e.peripherals.table.passengers"}}</label>
                    <input class="input-small" type="number" name="system.pass" value="{{item.system.pass}}" placeholder="0"/>
                    {{/if}}
                </div>
                <div class="itemGroup">
                    <img src="systems/eclipsephase/resources/icons/power.webp" class="icon-small"/>
                    <input class="input-small alignCenter" type="number" name="system.armor.energy" value="{{item.system.armor.energy}}" placeholder="0"/>
                    <img src="systems/eclipsephase/resources/icons/shield.webp" class="icon-small" style="max-width: 20px!important; max-height: 20px!important;"/>
                    <input class="input-small alignCenter" type="number" name="system.armor.kinetic" value="{{item.system.armor.kinetic}}" placeholder="0"/>
                </div>
            </div>

            <div class="itemRowHeader">
                <div class="itemGroup">
                    <img src="systems/eclipsephase/resources/icons/insightBright.webp" class="icon-small"/>
                    <label class="resource-value">{{localize "ep2e.morph.currentMorph.insightLabel"}}</label>
                    <input class="input-xs" onFocus="this.select()" type="number" name="system.insight" value="{{item.system.insight}}" placeholder="0"/>
                </div>
                <div class="itemGroup">
                    <img src="systems/eclipsephase/resources/icons/moxieBright.webp" class="icon-small"/>
                    <label class="resource-value">{{localize "ep2e.morph.currentMorph.moxieLabel"}}</label>
                    <input class="input-xs" onFocus="this.select()" type="number" name="system.moxie" value="{{item.system.moxie}}" placeholder="0"/>
                </div>
                <div class="itemGroup">
                    <img src="systems/eclipsephase/resources/icons/vigorBright.webp" class="icon-small"/>
                    <label class="resource-value">{{localize "ep2e.morph.currentMorph.vigorLabel"}}</label>
                    <input class="input-xs" onFocus="this.select()" type="number" name="system.vigor" value="{{item.system.vigor}}" placeholder="0"/>
                </div>
                <div class="itemGroup">
                    <img src="systems/eclipsephase/resources/icons/flexBright.webp" class="icon-small"/>
                    <label class="resource-value">{{localize "ep2e.morph.currentMorph.flexLabel"}}</label>
                    <input class="input-xs" onFocus="this.select()" type="number" name="system.flex" value="{{item.system.flex}}" placeholder="0"/>
                </div>
                {{#if (eq item.system.chassisType "animal")}}
                <div class="itemGroup">
                    <label class="resource-value">{{localize "ep2e.healthbar.tooltip.threat"}}</label>
                    <input class="input-xs" onFocus="this.select()" type="number" name="system.threat" value="{{item.system.threat}}" placeholder="0"/>
                </div>
                {{/if}}
            </div>

            {{> systems/eclipsephase/templates/item/partials/movement-grid.hbs item=item config=config}}

            {{#if (eq item.system.chassisType "animal")}}
            <div class="itemRow">
                <div class="itemGroup">
                    <i class="fa-solid fa-brain awesomeIcon icon-small"></i>
                    <label class="resource-value">{{localize "ep2e.healthbar.tooltip.stressluc"}}</label>
                    <input class="input-small" type="number" name="system.luc" value="{{item.system.luc}}" placeholder="0"/>
                </div>
                <div class="itemGroup">
                    <i class="fa-regular fa-stopwatch awesomeIcon icon-small"></i>
                    <label class="resource-value">{{localize "ep2e.healthbar.tooltip.initiative"}}</label>
                    <input class="input-small" type="number" name="system.init" value="{{item.system.init}}" placeholder="0"/>
                </div>
            </div>

            <p class="headline5">{{localize "ep2e.actorSheet.aptitudes.headline"}}</p>
            <div class="grid grid-3col">
                {{#each item.system.aptitudes as |aptitude key|}}
                <div class="flexrow flex-group-center reveal standard-height">
                    <div class="flexrow flex-group-center input-small">
                        <span class="resource-value alignCenter" style="min-width: 26px;">{{localize aptitude.label}}</span>
                        <label class="roll-label task-check noShow" data-type="aptitude" data-name="{{localize aptitude.name}}" data-key="item.system.aptitudes.{{key}}.value" data-apttype="{{key}}" data-rollvalue="{{aptitude.roll}}">
                            <img src="icons/svg/d10-grey.svg" class="icon-small"/>
                        </label>
                    </div>
                    <input class="input-small" type="number" name="system.aptitudes.{{key}}.value" value="{{aptitude.value}}" data-dtype="Number" placeholder="0"/>
                </div>
                {{/each}}
            </div>
            {{/if}}

            <div style="display: flex;">
                <p class="headline5" style="flex-grow: 1;">{{#if (eq item.system.chassisType "animal")}}{{localize "ep2e.peripherals.skillsHeadline"}}{{else}}{{localize "ep2e.peripherals.aiSkillsHeadline"}}{{/if}}</p>
                {{#if (ne item.system.chassisType "animal")}}
                <button type="button" class="autoBot" style="min-width: 100px; max-width: 350px; width:fit-content; max-height: 30px; display: flex; align-items: center; justify-content: center;" data-name="{{item.name}}" data-id="{{item.id}}">
                    {{localize "ep2e.item.vehicle.autoBot"}}
                </button>
                {{/if}}
            </div>
            <div style="overflow-x: hidden; overflow-y: auto; max-height: 200px;">
                {{#each item.system.skills as |skill key|}}
                <div class="flexrow flex-group-center reveal" style="padding: 5px 5px;">
                    <label class="input-xs resource-value">{{key}}.</label>
                    <input type="text" name="system.skills.{{key}}.name" value="{{skill.name}}" placeholder="Skill Name"/>
                    <input class="input-small" type="number" name="system.skills.{{key}}.value" value="{{skill.value}}" data-dtype="Number" placeholder="0"/>
                    <input type="text" class="input-largeSpec" name="system.skills.{{key}}.specname" value="{{skill.specname}}" placeholder="Spec"/>
                </div>
                {{/each}}
            </div>
        </div>

        <div class="tab {{#if (eq tabGroups.primary 'additions')}}active{{/if}}" data-group="primary" data-tab="additions">
            {{> systems/eclipsephase/templates/item/partials/additions-tab.hbs item=item}}
        </div>

        <div class="tab morph {{#if (eq tabGroups.primary 'description')}}active{{/if}}" data-group="primary" data-tab="description" style="min-height: 322px;">
            {{#if editable}}
                <prose-mirror
                    name="system.description"
                    button="true"
                    editable="true"
                    toggled="false"
                    value="{{item.system.description}}">
                    {{{htmlDescription}}}
                </prose-mirror>
            {{else}}
                {{{htmlDescription}}}
            {{/if}}
        </div>

        <div class="tab {{#if (eq tabGroups.primary 'effects')}}active{{/if}}" data-group="primary" data-tab="effects">
            {{> systems/eclipsephase/templates/actor/partials/tabs/gm-info-tab.html}}
        </div>
    </section>
</form>
