<form class="{{cssClass}}" autocomplete="off">
    {{> systems/eclipsephase/templates/item/partials/sheet-titlebar.hbs}}
    {{> systems/eclipsephase/templates/item/partials/sheet-tabs.hbs}}

    <section class="item-sheet-body">
        <div class="tab {{#if (eq tabGroups.primary 'details')}}active{{/if}}" data-group="primary" data-tab="details">
<div class="ep-sheet-strip">
    {{#each item.system.rep as |repType key|}}
    <div class="ep-strip-cell">
        <div class="reveal item ep-rep-head">
            <span class="toggle resource-label">{{localize repType.name}}</span>
            <div class="toggle noShow">
                <img data-type="skill" data-key="rep" data-name="{{key}}" data-rollvalue="{{repType.value}}" src="icons/svg/d10-grey.svg" class="icon-small roll-label task-check"/>
            </div>
        </div>
        <input onFocus="this.select()" type="text" name="system.rep.{{key}}.value" value="{{repType.value}}" placeholder="0"/>
        <span class="resource-sub-label">{{localize "ep2e.id.complexity.min"}}</span>
        <div class="ep-strip-checks ep-strip-checks-stacked">
            <input type="checkbox" class="sheet" name="system.rep.{{key}}.small1" {{checked repType.small1}}>
            <input type="checkbox" class="sheet" name="system.rep.{{key}}.small2" {{checked repType.small2}}>
            <input type="checkbox" class="sheet" name="system.rep.{{key}}.small3" {{checked repType.small3}}>
        </div>
        <span class="resource-sub-label">{{localize "ep2e.id.complexity.mod"}}</span>
        <div class="ep-strip-checks">
            <input type="checkbox" class="sheet" name="system.rep.{{key}}.med1" {{checked repType.med1}}>
        </div>
        <span class="resource-sub-label">{{localize "ep2e.id.complexity.maj"}}</span>
        <div class="ep-strip-checks">
            <input type="checkbox" class="sheet" name="system.rep.{{key}}.large" {{checked repType.large}}>
        </div>
    </div>
    {{/each}}
</div>
        </div>

        {{> systems/eclipsephase/templates/item/partials/sheet-description.hbs}}
        {{> systems/eclipsephase/templates/item/partials/sheet-effects.hbs}}
    </section>
</form>
