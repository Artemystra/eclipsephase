<form class="{{cssClass}}" autocomplete="off">
    {{> systems/eclipsephase/templates/item/partials/sheet-titlebar.hbs}}
    {{> systems/eclipsephase/templates/item/partials/sheet-tabs.hbs}}

    <section class="item-sheet-body">
        <div class="tab {{#if (eq tabGroups.primary 'details')}}active{{/if}}" data-group="primary" data-tab="details">
<div class="ep-sheet-grid ep-sheet-grid-3">
<label class="ep-field">
    <span class="resource-label">{{localize "ep2e.item.aspect.table.type.label"}}</span>
    <select name="system.psiType" data-type="String">
        {{selectOptions config.psiTypes selected=item.system.psiType localize=true}}
    </select>
</label>
<label class="ep-field">
    <span class="resource-label">{{localize "ep2e.item.aspect.table.family.label"}}</span>
    <select name="system.strainFamily" data-type="String" {{#if item.actor}}disabled{{/if}}>
        {{selectOptions config.strainFamilies selected=item.system.strainFamily localize=true}}
    </select>
</label>
{{#if (ne item.system.psiType "chi")}}
<label class="ep-field">
    <span class="resource-label">{{localize "ep2e.item.aspect.table.action.label"}}</span>
    <select name="system.actionType" data-type="String">
        {{selectOptions config.actionTypes selected=item.system.actionType localize=true}}
    </select>
</label>
<label class="ep-field">
    <span class="resource-label">{{localize "ep2e.item.aspect.table.duration.label"}}</span>
    <select name="system.duration" data-type="String">
        {{selectOptions config.duration selected=item.system.duration localize=true}}
    </select>
</label>
<label class="ep-field">
    <span class="resource-label">{{localize "ep2e.item.aspect.table.modifierLabel"}}</span>
    <input onFocus="this.select()" type="number" name="system.infection" value="{{item.system.infection}}" placeholder="3"/>
</label>
{{/if}}
</div>
        </div>
        <div class="tab {{#if (eq tabGroups.primary 'mechanics')}}active{{/if}}" data-group="primary" data-tab="mechanics">
{{> systems/eclipsephase/templates/item/partials/aspect-mechanics.hbs}}
        </div>

        {{> systems/eclipsephase/templates/item/partials/sheet-description.hbs}}
        {{> systems/eclipsephase/templates/item/partials/sheet-effects.hbs}}
    </section>
</form>
