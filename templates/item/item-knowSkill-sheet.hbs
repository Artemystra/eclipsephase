<form class="{{cssClass}}" autocomplete="off">
    <div class="ep-sheet-titlebar">
        <div class="ep-titlebar-logo centerBackground">
            <img class="logo-img" src="systems/eclipsephase/resources/img/logoalt.webp" title="ep2e logo"/>
        </div>
        <div class="ep-titlebar-name centerBackground">
            <input name="name" type="text" value="{{item.name}}" placeholder="Name" style="width: 100%;"/>
            <span class="ep-titlebar-name-plain">{{item.name}}</span>
        </div>
    </div>

    <section class="item-sheet-body">
<div class="ep-sheet-grid ep-sheet-grid-3">
<label class="ep-field">
    <span class="resource-label">{{localize "ep2e.item.additionalSkill.table.valueLabel"}}</span>
    <input onFocus="this.select()" type="number" name="system.value" value="{{item.system.value}}" placeholder="0" data-dtype="Number"/>
</label>
{{#unless item.system.isThreat}}
<label class="ep-field">
    <span class="resource-label">{{localize "ep2e.item.additionalSkill.table.aptitudeLabel"}}</span>
    <select name="system.aptitude" data-type="String">
        {{selectOptions config.knowAptitudes selected=item.system.aptitude localize=true}}
    </select>
</label>
{{/unless}}
<label class="ep-field">
    <span class="resource-label">{{localize "ep2e.item.additionalSkill.table.specLabel"}}</span>
    <input onFocus="this.select()" type="text" name="system.specname" value="{{item.system.specname}}" placeholder="Spec name"/>
</label>
</div>
    </section>
</form>
