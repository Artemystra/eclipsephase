<div class="flexrow subheader">
    <h3 class="subheader dialog">{{localize "ep2e.item.weapon.table.section.attack"}}</h3>
</div>
<div class="ep-sheet-grid ep-sheet-grid-4 munition-fields">
{{#if (eq item.system.traits.noDamage.value true)}}
<div class="ep-field ep-field-bound">
    <span class="resource-label">{{localize "ep2e.item.weapon.table.damageValue"}}</span>
    <span>{{localize "ep2e.item.weapon.table.trait.noDamage"}}</span>
</div>
{{else if (eq item.system.traits.dvHalved.value true)}}
<div class="ep-field ep-field-bound">
    <span class="resource-label">{{localize "ep2e.item.weapon.table.damageValue"}}</span>
    <span>{{localize "ep2e.item.weapon.table.trait.dvHalved"}}</span>
</div>
{{else}}
{{> systems/eclipsephase/templates/item/partials/field-dice.hbs label="ep2e.item.weapon.table.damageValue" path="system.dv" values=item.system.dv}}
{{/if}}
<label class="ep-field">
    <span class="resource-label">{{localize "ep2e.item.weapon.table.effectArea"}}</span>
    <select name="system.area.kind" data-type="String">
        {{selectOptions config.areaKinds selected=item.system.area.kind localize=true}}
    </select>
</label>
<label class="ep-field">
    <span class="resource-label">{{localize "ep2e.item.weapon.table.area.radius"}}</span>
    <div class="ep-field-unit">
        <input onFocus="this.select()" type="number" min="0" name="system.area.radius" value="{{item.system.area.radius}}" placeholder="10"{{#unless (eq item.system.area.kind "uniform")}} disabled{{/unless}}/>
        <span>m</span>
    </div>
</label>
<label class="ep-field">
    <span class="resource-label">{{localize "ep2e.item.weapon.table.area.reduction"}}</span>
    <div class="ep-field-unit">
        <span>-</span>
        <input onFocus="this.select()" type="number" min="0" name="system.area.reduction" value="{{item.system.area.reduction}}" placeholder="2"{{#if (eq item.system.area.kind "none")}} disabled{{/if}}/>
        <span>DV/m</span>
    </div>
</label>
{{#if (eq item.type "ammo")}}
<label class="ep-field">
    <span class="resource-label">{{localize "ep2e.item.weapon.table.size.label"}}</span>
    <select name="system.size" data-type="String">
        {{selectOptions config.munitionSizes selected=item.system.size localize=true}}
    </select>
</label>
{{/if}}
</div>
<div class="flexrow subheader">
    <h3 class="subheader dialog">{{localize "ep2e.item.weapon.table.payload.enabled"}}</h3>
</div>
{{> systems/eclipsephase/templates/item/partials/munition-payload.hbs columns=4}}
<div class="flexrow subheader">
    <h3 class="subheader dialog">{{localize "ep2e.item.weapon.table.section.traits"}}</h3>
</div>
{{> systems/eclipsephase/templates/item/partials/weapon-choice-pills.hbs choices=item.system.traits path="system.traits" placeholderKey="ep2e.item.weapon.table.addTrait"}}
