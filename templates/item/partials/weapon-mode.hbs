{{#*inline "weaponMode"}}
<div class="tab {{tab}}" data-group="primary" data-tab="{{tab}}">
    {{#if item.system.additionalMode}}
    <div class="ep-sheet-grid ep-sheet-grid-4">
        <label class="ep-field ep-span-2">
            <span class="resource-label">{{localize "ep2e.item.weapon.table.modeName"}}</span>
            <input onFocus="this.select()" type="text" name="system.{{mode}}.name" value="{{modeData.name}}" placeholder="{{localize placeholder}}"/>
        </label>
    </div>
    {{/if}}

    <div class="flexrow subheader">
        <h3 class="subheader dialog">{{localize "ep2e.item.weapon.table.section.general"}}</h3>
    </div>
    <div class="ep-sheet-grid ep-sheet-grid-4">
        {{#if (eq mode "mode1")}}
            {{#if (eq type "ranged")}}
            <label class="ep-field">
                <span class="resource-label">{{localize "ep2e.item.weapon.table.maxAmmo"}}</span>
                <input onFocus="this.select()" type="number" name="system.ammoMax" value="{{item.system.ammoMax}}" placeholder="12"/>
            </label>
            <label class="ep-field">
                <span class="resource-label">{{localize "ep2e.item.weapon.table.type.label"}}</span>
                <select name="system.ammoType" data-type="String">
                    {{selectOptions config.rangedAmmoType selected=item.system.ammoType localize=true}}
                </select>
            </label>
            {{/if}}
            {{> systems/eclipsephase/templates/item/partials/field-cost.hbs}}
            <label class="ep-field">
                <span class="resource-label">{{localize "ep2e.item.weapon.table.slot.label"}}</span>
                <select name="system.slotType" data-type="String">
                    {{selectOptions config.weaponTypes selected=item.system.slotType localize=true}}
                </select>
            </label>
        {{else}}
            {{#if (eq type "ranged")}}
            <div class="ep-field ep-field-bound">
                <span class="resource-label">{{localize "ep2e.item.weapon.table.maxAmmo"}}</span>
                <span>{{item.system.ammoMax}}</span>
            </div>
            <div class="ep-field ep-field-bound">
                <span class="resource-label">{{localize "ep2e.item.weapon.table.type.label"}}</span>
                <span>{{localize item.system.ammoName}}</span>
            </div>
            {{/if}}
            <div class="ep-field ep-field-bound">
                <span class="resource-label">{{localize "ep2e.item.general.table.cost.label"}}</span>
                <span>{{localize item.system.costName}}</span>
            </div>
            <div class="ep-field ep-field-bound">
                <span class="resource-label">{{localize "ep2e.item.weapon.table.slot.label"}}</span>
                <span>{{localize item.system.slotName}}</span>
            </div>
        {{/if}}
    </div>

    <div class="flexrow subheader">
        <h3 class="subheader dialog">{{localize "ep2e.item.weapon.table.section.attack"}}</h3>
    </div>
    <div class="ep-sheet-grid ep-sheet-grid-4">
        {{> systems/eclipsephase/templates/item/partials/field-dice.hbs label="ep2e.item.weapon.table.damageValue" path=(concat "system." mode) values=modeData}}
        <label class="ep-field">
            <span class="resource-label">{{localize "ep2e.item.weapon.table.armorUsed.label"}}</span>
            <select name="system.{{mode}}.armorused" data-type="String">
                {{selectOptions config.armorUsed selected=modeData.armorused localize=true}}
            </select>
        </label>
        {{#if (eq type "ranged")}}
        <label class="ep-field">
            <span class="resource-label">{{localize "ep2e.item.weapon.table.range"}}</span>
            <div class="ep-field-unit">
                <input onFocus="this.select()" type="number" min="0" name="system.{{mode}}.range" value="{{modeData.range}}" placeholder="120"/>
                <span>m</span>
            </div>
        </label>
        <label class="ep-field">
            <span class="resource-label">{{localize "ep2e.item.weapon.table.firingMode.label"}}</span>
            <select name="system.{{mode}}.firingMode" data-type="String">
                {{selectOptions config.firingModes selected=modeData.firingMode localize=true}}
            </select>
        </label>
        {{/if}}
    </div>

    <div class="flexrow subheader">
        <h3 class="subheader dialog">{{localize "ep2e.item.weapon.table.section.traits"}}</h3>
    </div>
    {{> systems/eclipsephase/templates/item/partials/weapon-choice-pills.hbs choices=modeData.traits path=(concat "system." mode ".traits") placeholderKey="ep2e.item.weapon.table.addTrait"}}

    <div class="flexrow subheader">
        <h3 class="subheader dialog">{{localize "ep2e.item.weapon.table.section.accessories"}}</h3>
    </div>
    {{> systems/eclipsephase/templates/item/partials/weapon-choice-pills.hbs choices=item.system.accessories path="system.accessories" placeholderKey="ep2e.item.weapon.table.addAccessory"}}
</div>
{{/inline}}

{{> weaponMode tab="details" mode="mode1" modeData=item.system.mode1 placeholder="ep2e.item.general.tabs.weaponMode1"}}
{{> weaponMode tab="details2" mode="mode2" modeData=item.system.mode2 placeholder="ep2e.item.general.tabs.weaponMode2"}}
