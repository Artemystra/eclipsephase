<div class="flexrow subheader">
    <h3 class="subheader dialog">{{localize "ep2e.morph.currentMorph.movement.label"}}</h3>
</div>
<div class="ep-sheet-grid ep-sheet-grid-4">
    {{#each @root.visibleMovement as |mov key|}}
    <div class="ep-field ep-span-2">
        <span class="resource-label">{{mov.label}}</span>
        <div class="ep-field-unit">
            <input onFocus="this.select()" type="number" name="system.movement.{{key}}.base" value="{{mov.base}}" placeholder="0" data-tooltip="{{localize 'ep2e.morph.currentMorph.movement.speed'}}"/>
            <span>/</span>
            <input onFocus="this.select()" type="number" name="system.movement.{{key}}.full" value="{{mov.full}}" placeholder="0" data-tooltip="{{localize 'ep2e.morph.currentMorph.movement.speed'}}"/>
            <select name="system.movement.{{key}}.type" data-type="String" data-tooltip="{{localize 'ep2e.morph.currentMorph.movement.type'}}">
                {{selectOptions @root.config.moveTypes selected=mov.type localize=true}}
            </select>
        </div>
    </div>
    {{/each}}
</div>
