<div class="flexrow subheader">
    <h3 class="subheader dialog">{{localize "ep2e.inventory.npcInventory.wareLabel"}}</h3>
</div>
<div class="ep-sheet-grid ep-sheet-grid-4">
    {{#each @root.visibleWare as |ware key|}}
    <label class="ep-field">
        <span class="resource-label">{{ware.label}}</span>
        <select name="system.ware.{{key}}.value" data-type="String">
            {{selectOptions @root.itemList.ware selected=ware.value}}
        </select>
    </label>
    {{/each}}
</div>
