<form class="{{cssClass}}" autocomplete="off">
    {{> systems/eclipsephase/templates/item/partials/sheet-titlebar.hbs}}
    {{> systems/eclipsephase/templates/item/partials/sheet-tabs.hbs}}

    <section class="item-sheet-body">
        <div class="tab {{#if (eq tabGroups.primary 'details')}}active{{/if}}" data-group="primary" data-tab="details">
{{#if (or skillSetup immunities.length)}}
<div class="flexrow subheader">
    <h3 class="subheader dialog">{{localize "ep2e.item.weapon.table.section.general"}}</h3>
</div>
{{/if}}
<div class="ep-sheet-grid ep-sheet-grid-3">
<label class="ep-field">
    <span class="resource-label">{{localize "ep2e.item.ware.table.type.label"}}</span>
    <select name="system.wareType" data-type="String">
        {{selectOptions config.wareTypes selected=item.system.wareType localize=true}}
    </select>
</label>
{{> systems/eclipsephase/templates/item/partials/field-cost.hbs}}
</div>
{{#if skillSetup}}
            <div class="flexrow subheader">
                <h3 class="subheader dialog">{{localize "ep2e.item.ware.skillSetup.headline"}}</h3>
            </div>
            <div class="flexrow ware-skill-picks">
                <span>{{#if skillPicks.length}}{{#each skillPicks as |name|}}{{name}}{{#unless @last}}, {{/unless}}{{/each}}{{else}}<i>{{localize "ep2e.item.ware.skillSetup.none"}}</i>{{/if}}</span>
                {{#if editable}}<button type="button" class="ware-skill-setup">{{localize "ep2e.item.ware.skillSetup.button"}}</button>{{/if}}
            </div>
            {{/if}}
            {{#if immunities.length}}
            <div class="flexrow subheader">
                <h3 class="subheader dialog">{{localize "ep2e.item.ware.immunities.headline"}}</h3>
            </div>
            <div class="ware-immunities">
                {{#each immunities as |name|}}
                <div class="flexrow ware-immunity">
                    <span>{{name}}</span>
                    {{#if ../editable}}
                    <a class="immunity-delete" data-name="{{name}}" data-tooltip="{{localize 'ep2e.item.ware.immunities.forget'}}"><i class="far fa-times-circle awesomeIcon"></i></a>
                    {{/if}}
                </div>
                {{/each}}
            </div>
            {{/if}}
        </div>

        {{> systems/eclipsephase/templates/item/partials/sheet-description.hbs}}
        {{> systems/eclipsephase/templates/item/partials/sheet-effects.hbs}}
    </section>
</form>
