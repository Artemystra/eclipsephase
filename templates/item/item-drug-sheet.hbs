<form class="{{cssClass}}" autocomplete="off">
    {{> systems/eclipsephase/templates/item/partials/sheet-titlebar.hbs}}
    {{> systems/eclipsephase/templates/item/partials/sheet-tabs.hbs}}

    <section class="item-sheet-body">
        <div class="tab {{#if (eq tabGroups.primary 'details')}}active{{/if}}" data-group="primary" data-tab="details">
<div class="ep-sheet-grid ep-sheet-grid-4">
<label class="ep-field">
    <span class="resource-label">{{localize "ep2e.item.drug.table.category.label"}}</span>
    <select name="system.category" data-type="String">
        {{selectOptions config.drugCategories selected=item.system.category localize=true}}
    </select>
</label>
<label class="ep-field">
    <span class="resource-label">{{localize "ep2e.item.drug.table.type.label"}}</span>
    <select name="system.drugType" data-type="String">
        {{selectOptions config.drugTypes selected=item.system.drugType localize=true}}
    </select>
</label>
<div class="ep-field" data-tooltip="{{localize 'ep2e.item.drug.table.usagesTip'}}">
    <span class="resource-label">{{localize "ep2e.item.drug.table.usagesMax"}}</span>
    <div class="ep-field-unit">
        <input onFocus="this.select()" type="number" name="system.usagesUsed" min="0" value="{{item.system.usagesUsed}}"/>
        <span>/</span>
        <input onFocus="this.select()" type="number" name="system.usagesMax" min="1" value="{{item.system.usagesMax}}"/>
    </div>
</div>
{{> systems/eclipsephase/templates/item/partials/field-cost.hbs}}
</div>
<div class="flexrow subheader">
    <h3 class="subheader dialog">{{localize "ep2e.item.drug.table.applicationVectors.headline"}}</h3>
</div>
<div class="ep-sheet-strip">
<div class="ep-field">
    <label class="resource-label" for="system.dermal-{{item._id}}">{{localize "ep2e.item.drug.table.applicationVectors.dermalLabel"}}</label>
    <input type="checkbox" class="sheet" id="system.dermal-{{item._id}}" name="system.dermal" {{checked item.system.dermal}}/>
</div>
<div class="ep-field">
    <label class="resource-label" for="system.inhalation-{{item._id}}">{{localize "ep2e.item.drug.table.applicationVectors.inhalationLabel"}}</label>
    <input type="checkbox" class="sheet" id="system.inhalation-{{item._id}}" name="system.inhalation" {{checked item.system.inhalation}}/>
</div>
<div class="ep-field">
    <label class="resource-label" for="system.injection-{{item._id}}">{{localize "ep2e.item.drug.table.applicationVectors.injectionLabel"}}</label>
    <input type="checkbox" class="sheet" id="system.injection-{{item._id}}" name="system.injection" {{checked item.system.injection}}/>
</div>
<div class="ep-field">
    <label class="resource-label" for="system.oral-{{item._id}}">{{localize "ep2e.item.drug.table.applicationVectors.oralLabel"}}</label>
    <input type="checkbox" class="sheet" id="system.oral-{{item._id}}" name="system.oral" {{checked item.system.oral}}/>
</div>
<div class="ep-field">
    <label class="resource-label" for="system.isAmmo-{{item._id}}">{{localize "ep2e.item.drug.table.isAmmo"}}</label>
    <input type="checkbox" class="sheet" id="system.isAmmo-{{item._id}}" name="system.isAmmo" {{checked item.system.isAmmo}}/>
</div>
</div>
        </div>
        <div class="tab {{#if (eq tabGroups.primary 'mechanics')}}active{{/if}}" data-group="primary" data-tab="mechanics">
{{> systems/eclipsephase/templates/item/partials/induced-changes.hbs}}
<div class="flexrow subheader">
    <h3 class="subheader dialog">{{localize "ep2e.item.drug.mechanics.checkHeadline"}}</h3>
</div>
<div class="ep-sheet-grid ep-sheet-grid-4">
<label class="ep-field">
    <span class="resource-label">{{localize "ep2e.item.drug.mechanics.aptitude"}}</span>
    <select name="system.useCheck.aptitude" data-type="String">
        {{selectOptions config.drugCheckAptitudes selected=item.system.useCheck.aptitude localize=true}}
    </select>
</label>
<label class="ep-field">
    <span class="resource-label">{{localize "ep2e.item.drug.mechanics.modifier"}}</span>
    <input onFocus="this.select()" type="number" name="system.useCheck.modifier" value="{{item.system.useCheck.modifier}}" placeholder="0"/>
</label>
<label class="ep-field">
    <span class="resource-label">{{localize "ep2e.item.drug.mechanics.failure"}}</span>
    <select name="system.useCheck.failure" data-type="String">
        {{selectOptions config.drugCheckFailures selected=item.system.useCheck.failure localize=true}}
    </select>
</label>
<label class="ep-field">
    <span class="resource-label">{{localize "ep2e.item.drug.mechanics.lasts"}}</span>
    <div class="ep-field-unit">
        <input class="ep-field-short" onFocus="this.select()" type="number" name="system.useCheck.duration.value" min="1" value="{{item.system.useCheck.duration.value}}"/>
        <select name="system.useCheck.duration.units" data-type="String">
            {{selectOptions config.drugDurationUnits selected=item.system.useCheck.duration.units localize=true}}
        </select>
    </div>
</label>
{{> systems/eclipsephase/templates/item/partials/field-dice.hbs label="ep2e.item.drug.mechanics.harm" path="system.useCheck.stress" values=item.system.useCheck.stress}}
<label class="ep-field">
    <span class="resource-label">{{localize "ep2e.item.drug.mechanics.successPsi"}}</span>
    <input onFocus="this.select()" type="number" name="system.useCheck.successPsiPenalty" value="{{item.system.useCheck.successPsiPenalty}}" placeholder="0"/>
</label>
</div>
<div class="flexrow subheader">
    <h3 class="subheader dialog">{{localize "ep2e.item.drug.mechanics.overTimeHeadline"}}</h3>
</div>
<div class="ep-sheet-grid ep-sheet-grid-4">
<label class="ep-field">
    <span class="resource-label">{{localize "ep2e.item.drug.table.duration"}}</span>
    <input onFocus="this.select()" type="number" name="system.duration.value" value="{{item.system.duration.value}}" placeholder="0" min="1"/>
</label>
<label class="ep-field">
    <span class="resource-label">{{localize "ep2e.item.drug.table.durationUnits.label"}}</span>
    <select name="system.duration.units" data-type="String">
        {{selectOptions config.drugDurationUnits selected=item.system.duration.units localize=true}}
    </select>
</label>
<label class="ep-field">
    <span class="resource-label">{{localize "ep2e.item.drug.mechanics.interval"}}</span>
    <select name="system.overTime.interval" data-type="String">
        {{selectOptions config.drugOverTimeIntervals selected=item.system.overTime.interval localize=true}}
    </select>
</label>
<label class="ep-field" data-tooltip="{{localize 'ep2e.item.drug.mechanics.ticksTip'}}">
    <span class="resource-label">{{localize "ep2e.item.drug.mechanics.ticks"}}</span>
    <input onFocus="this.select()" type="number" name="system.overTime.ticks" min="1" value="{{item.system.overTime.ticks}}"/>
</label>
{{> systems/eclipsephase/templates/item/partials/field-dice.hbs label="ep2e.item.drug.mechanics.damage" path="system.overTime.damage" values=item.system.overTime.damage}}
<label class="ep-field" data-tooltip="{{localize 'ep2e.item.drug.mechanics.growingModifierTip'}}">
    <span class="resource-label">{{localize "ep2e.item.drug.mechanics.growingModifier"}}</span>
    <input onFocus="this.select()" type="number" name="system.overTime.modifier" value="{{item.system.overTime.modifier}}" placeholder="0"/>
</label>
<div class="ep-field" data-tooltip="{{localize 'ep2e.item.drug.mechanics.incapacitatesTip'}}">
    <label class="resource-label" for="system.overTime.incapacitates-{{item._id}}">{{localize "ep2e.item.drug.mechanics.incapacitates"}}</label>
    <input type="checkbox" class="sheet" id="system.overTime.incapacitates-{{item._id}}" name="system.overTime.incapacitates" {{checked item.system.overTime.incapacitates}}/>
</div>
<label class="ep-field" data-tooltip="{{localize 'ep2e.item.drug.mechanics.healingTip'}}">
    <span class="resource-label">{{localize "ep2e.item.drug.mechanics.healing"}}</span>
    <select name="system.healingAddition" data-type="String">
        {{selectOptions config.drugHealingAdditions selected=item.system.healingAddition localize=true}}
    </select>
</label>
</div>
<div class="flexrow subheader">
    <h3 class="subheader dialog">{{localize "ep2e.item.drug.mechanics.grantHeadline"}}</h3>
</div>
<div class="grant-rows">
                <div class="flexrow grant-row grant-row-labels">
                    <span class="grant-connector-slot"></span>
                    <label class="resource-label">{{localize "ep2e.item.drug.mechanics.grantPack"}}</label>
                    <label class="resource-label">{{localize "ep2e.item.drug.mechanics.grantFolder"}}</label>
                    <label class="resource-label">{{localize "ep2e.item.drug.mechanics.grantItem"}}</label>
                    <span class="grant-button-slot"></span>
                </div>
                {{#each grantRows as |row|}}
                <div class="flexrow grant-row" data-grant-index="{{row.index}}">
                    <span class="grant-connector-slot">
                        {{#unless row.first}}
                        <button type="button" class="grant-connector{{#if row.or}} grant-or{{/if}}" data-tooltip="{{localize 'ep2e.item.drug.mechanics.connectorTip'}}">{{#if row.or}}{{localize "ep2e.item.drug.mechanics.connectorOr"}}{{else}}{{localize "ep2e.item.drug.mechanics.connectorAnd"}}{{/if}}</button>
                        {{/unless}}
                    </span>
                    <select class="grant-pack">
                        <option value="">{{localize "ep2e.item.drug.mechanics.none"}}</option>
                        {{#each row.packOptions as |option|}}
                        <option value="{{option.value}}"{{#if option.selected}} selected{{/if}}>{{option.label}}</option>
                        {{/each}}
                    </select>
                    <select class="grant-folder"{{#unless row.hasFolders}} disabled{{/unless}}>
                        <option value="">{{localize "ep2e.item.drug.mechanics.none"}}</option>
                        {{#each row.folderOptions as |option|}}
                        <option value="{{option.value}}"{{#if option.selected}} selected{{/if}}>{{option.label}}</option>
                        {{/each}}
                    </select>
                    <select class="grant-item"{{#if row.open}} disabled{{/if}}>
                        <option value="random"{{#if row.random}} selected{{/if}}>{{localize "ep2e.item.drug.mechanics.random"}}</option>
                        {{#each row.itemOptions as |option|}}
                        <option value="{{option.value}}"{{#if option.selected}} selected{{/if}}>{{option.label}}</option>
                        {{/each}}
                    </select>
                    <span class="grant-button-slot">
                        {{#unless row.open}}
                        <a class="grant-description{{#if row.hasText}} grant-has-description{{/if}}" data-tooltip="{{localize 'ep2e.item.drug.mechanics.grantDescription'}}"><i class="fas fa-pen-to-square awesomeIcon"></i></a>
                        {{/unless}}
                    </span>
                </div>
                {{/each}}
            </div>
<div class="flexrow subheader">
    <h3 class="subheader dialog">{{localize "ep2e.item.drug.mechanics.wearOffHeadline"}}</h3>
</div>
<div class="ep-sheet-grid ep-sheet-grid-4">
{{> systems/eclipsephase/templates/item/partials/field-dice.hbs label="ep2e.item.drug.table.wearOffSv" path="system.wearOff" values=item.system.wearOff}}
</div>
<div class="flexrow subheader">
    <h3 class="subheader dialog">{{localize "ep2e.item.drug.mechanics.addictionHeadline"}}</h3>
</div>
<div class="ep-sheet-grid ep-sheet-grid-4">
<label class="ep-field">
    <span class="resource-label">{{localize "ep2e.item.drug.table.addictionModifier"}}</span>
    <input onFocus="this.select()" type="text" name="system.addictionMod" value="{{item.system.addictionMod}}" placeholder="-10"/>
</label>
<label class="ep-field">
    <span class="resource-label">{{localize "ep2e.item.drug.table.addictionType"}}</span>
    <select name="system.addictionType" data-type="String">
        {{selectOptions config.drugAddicitonTypes selected=item.system.addictionType localize=true}}
    </select>
</label>
</div>
        </div>

        {{> systems/eclipsephase/templates/item/partials/sheet-description.hbs}}
        {{> systems/eclipsephase/templates/item/partials/sheet-effects.hbs}}
    </section>
</form>
