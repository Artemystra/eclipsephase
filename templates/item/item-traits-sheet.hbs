<form class="{{cssClass}}" autocomplete="off">
    {{> systems/eclipsephase/templates/item/partials/sheet-titlebar.hbs}}

    <nav class="sheet-tabs itemnav tabs" data-group="primary">
        {{#each tabs.primary as |tab|}}
            {{#if (eq tab.id "effects")}}
                {{#if @root.item.showEffectsTab}}
                    <a class="item {{#if tab.active}}active{{/if}}" data-action="tab" data-group="primary" data-tab="{{tab.id}}"><span class="ep-tab-label">{{localize tab.label}}</span></a>
                {{/if}}
            {{else if (eq tab.id "details")}}
                <a class="item {{#if tab.active}}active{{/if}}" data-action="tab" data-group="primary" data-tab="{{tab.id}}"><span class="ep-tab-label">{{localize "ep2e.item.general.table.description"}}</span></a>
            {{/if}}
        {{/each}}
    </nav>

    <section class="item-sheet-body">
        <div class="tab {{#if (eq tabGroups.primary 'details')}}active{{/if}}" data-group="primary" data-tab="details">
            <div class="ep-sheet-grid ep-sheet-grid-3">
                <div class="ep-field">
                    <span class="resource-label">{{localize "ep2e.item.traits.typeLabel"}}</span>
                    <div class="ep-field-options">
                        {{radioBoxes "system.traitType" config.traitTypesShort checked=item.system.traitType localize=true}}
                    </div>
                </div>
                <div class="ep-field">
                    <label class="resource-label" for="ego-{{item._id}}">{{localize "ep2e.actorSheet.leftTabs.egoTab"}}</label>
                    <input type="checkbox" class="sheet" id="ego-{{item._id}}" name="system.ego" {{checked item.system.ego}}/>
                </div>
                <div class="ep-field">
                    <label class="resource-label" for="morph-{{item._id}}">{{localize "ep2e.actorSheet.rightTabs.morphTab"}}</label>
                    <input type="checkbox" class="sheet" id="morph-{{item._id}}" name="system.morph" {{checked item.system.morph}}/>
                </div>
            </div>
            {{#if editable}}
                <prose-mirror
                    name="system.description"
                    button="true"
                    editable="true"
                    toggled="false"
                    value="{{item.system.description}}">
                    {{{htmlDescription}}}
                </prose-mirror>
            {{else}}
                {{{htmlDescription}}}
            {{/if}}
        </div>

        {{> systems/eclipsephase/templates/item/partials/sheet-effects.hbs}}
    </section>
</form>
