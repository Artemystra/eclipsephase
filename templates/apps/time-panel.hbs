<div class="ep-time-panel-body">

    <div class="ep-sheet-titlebar ep-time-titlebar">
        <div class="ep-titlebar-name ep-time-titlebar-date">
            <div class="flexrow flex-group-left ep-time-date-fields">
                <label class="resource-label">{{localize "ep2e.time.year"}}</label>
                {{#if canControl}}
                <input class="alignCenter ep-time-date-input" type="number" name="year" min="1" value="{{year}}"/>
                {{else}}
                <span class="ep-time-date-value">{{year}}</span>
                {{/if}}
                <label class="resource-label">{{localize "ep2e.time.day"}}</label>
                {{#if canControl}}
                <input class="alignCenter ep-time-date-input" type="number" name="dayOfYear" min="1" value="{{dayOfYear}}"/>
                {{else}}
                <span class="ep-time-date-value">{{dayOfYear}}</span>
                {{/if}}
            </div>
        </div>
    </div>

    <div class="contentBox">
        <div class="centerBackground flexrow flex-group-center ep-time-clock"{{#if clockTooltip}} data-tooltip="{{clockTooltip}}"{{/if}}>
            {{#if canControl}}
                {{#if inBeats}}
                <span class="resource-value ep-time-big">@</span>
                <input class="alignCenter ep-time-big ep-time-clock-input ep-time-beat-input" type="number" name="beat" min="0" max="999" value="{{beat}}"/>
                {{else}}
                <input class="alignCenter ep-time-big ep-time-clock-input" type="number" name="hour" min="0" max="23" value="{{hour}}"/>
                <span class="resource-value ep-time-big">:</span>
                <input class="alignCenter ep-time-big ep-time-clock-input" type="number" name="minute" min="0" max="59" value="{{minute}}"/>
                {{/if}}
            {{else}}
            <span class="resource-value ep-time-big">{{timeOfDay}}</span>
            {{/if}}
            {{#if inBeats}}
            <a class="ep-time-beats-info" data-action="beatsInfo" data-tooltip="{{localize 'ep2e.time.beatsInfo.tip'}}"><i class="fas fa-circle-info awesomeIcon"></i></a>
            {{/if}}
        </div>
    </div>

    {{#if canControl}}
    <div class="contentBox">
        <div class="flexrow subheader">
            <h3 class="subheader">{{localize "ep2e.time.advance"}}</h3>
            <div class="alignRight flexGrowThreeQuarter"></div>
        </div>
        <div class="itemBackground">
            <div class="ep-time-presets">
                {{#each presets as |preset|}}
                <button type="button" class="ep-time-step" data-action="advance" data-seconds="{{preset.seconds}}"
                        {{#if preset.tooltip}}data-tooltip="{{preset.tooltip}}"{{/if}}>{{preset.label}}</button>
                {{/each}}
                <div class="ep-time-custom">
                    <input class="alignCenter ep-time-custom-input" type="number" name="customMinutes" placeholder="{{localize 'ep2e.time.customHint'}}"/>
                    <button type="button" class="ep-time-step ep-time-custom-go" data-action="advanceCustom" data-tooltip="{{localize 'ep2e.time.custom'}}"><i class="fas fa-forward awesomeIcon"></i></button>
                </div>
            </div>
            <div class="flexrow ep-time-manual ep-time-reset-row">
                <button type="button" class="ep-time-step" data-action="restoreRest">
                    <i class="fas fa-battery-full awesomeIcon"></i>{{localize "ep2e.time.restoreRest"}}
                </button>
                <label class="resource-label ep-time-auto-reset">
                    <input type="checkbox" data-action="toggleAutoReset" {{checked autoReset}}/>
                    {{localize "ep2e.time.autoReset"}}
                </label>
            </div>
        </div>
    </div>
    {{/if}}

    <div class="contentBox">
        <div class="flexrow subheader ep-time-effects-header" data-action="toggleEffects">
            <h3 class="subheader">{{localize "ep2e.time.effects"}}</h3>
            <div class="alignRight flexGrowThreeQuarter">
                <i class="fas fa-{{#if effectsOpen}}minus{{else}}plus{{/if}} icon-xsmall awesomeIcon alignRight"></i>
            </div>
        </div>
        {{#if effectsOpen}}
        <div class="itemBackground">
            {{#if grouped}}
            {{#if sections.length}}
            {{#each sections as |section|}}
            <div class="ep-time-section">
                <div class="flexrow ep-time-section-header{{#if section.collapsible}} ep-time-section-toggle{{/if}}"{{#if section.collapsible}} data-action="toggleThreats"{{/if}}>
                    <label class="resource-label alignLeft">{{localize section.label}}</label>
                    {{#if section.collapsible}}<i class="fas fa-{{#if section.open}}minus{{else}}plus{{/if}} icon-xsmall awesomeIcon alignRight"></i>{{/if}}
                </div>
                {{#if section.open}}
                {{#each section.groups as |group|}}
                    <div class="ep-time-actor-group">
                        <div class="item flexrow flex-group-center ep-time-actor-row" data-action="toggleActor" data-actor-uuid="{{group.actorUuid}}">
                            <i class="fas fa-caret-{{#if group.open}}down{{else}}right{{/if}} awesomeIcon ep-time-actor-caret"></i>
                            <label class="truncate alignLeft ep-time-actor-name"><strong>{{group.name}}</strong></label>
                            <label class="alignRight ep-time-actor-count">{{group.count}}</label>
                        </div>
                        {{#if group.open}}
                        {{#each group.effects as |row|}}
                        <div class="item flexrow flex-group-center ep-time-effect-row{{#if row.expired}} ep-time-expired{{/if}}">
                            <label class="truncate alignLeft ep-time-effect-name">{{row.name}}</label>
                            <label class="alignRight ep-time-effect-remaining">{{row.remaining}}</label>
                            <div class="flexrow item-controls flex-group-right ep-time-effect-controls">
                                {{#if row.hasInfo}}
                                <a class="item-control resource-label editWithLabel input-xs alignRight"
                                   data-action="effectInfo"
                                   data-actor-uuid="{{row.actorUuid}}"
                                   data-parent-id="{{row.parentId}}"
                                   data-effect-id="{{row.effectId}}"
                                   data-on-item="{{row.onItem}}"
                                   data-tooltip="{{localize 'ep2e.time.moreInfo'}}"><i class="fas fa-circle-info awesomeIcon"></i></a>
                                {{/if}}
                                {{#if @root.canControl}}
                                <a class="item-control resource-label editWithLabel input-xs alignRight"
                                   data-action="endEffect"
                                   data-actor-uuid="{{row.actorUuid}}"
                                   data-parent-id="{{row.parentId}}"
                                   data-effect-id="{{row.effectId}}"
                                   data-on-item="{{row.onItem}}"
                                   data-tooltip="{{localize 'ep2e.time.endNow'}}"><i class="far fa-times-circle awesomeIcon"></i></a>
                                {{/if}}
                            </div>
                        </div>
                        {{/each}}
                        {{/if}}
                    </div>
                {{/each}}
                {{/if}}
            </div>
            {{/each}}
            {{else}}
            <div class="flexrow flex-group-center ep-time-empty">
                <span class="resource-label">{{localize "ep2e.time.noEffects"}}</span>
            </div>
            {{/if}}

            {{else}}

            {{#if effects.length}}
            {{#each effects as |row|}}
            <div class="item flexrow flex-group-center ep-time-effect-row{{#if row.expired}} ep-time-expired{{/if}}">
                <label class="truncate alignLeft ep-time-effect-name">{{row.name}}</label>
                <label class="alignRight ep-time-effect-remaining">{{row.remaining}}</label>
                <div class="flexrow item-controls flex-group-right ep-time-effect-controls">
                    {{#if row.hasInfo}}
                    <a class="item-control resource-label editWithLabel input-xs alignRight"
                       data-action="effectInfo"
                       data-actor-uuid="{{row.actorUuid}}"
                       data-parent-id="{{row.parentId}}"
                       data-effect-id="{{row.effectId}}"
                       data-on-item="{{row.onItem}}"
                       data-tooltip="{{localize 'ep2e.time.moreInfo'}}"><i class="fas fa-circle-info awesomeIcon"></i></a>
                    {{/if}}
                </div>
            </div>
            {{/each}}
            {{else}}
            <div class="flexrow flex-group-center ep-time-empty">
                <span class="resource-label">{{localize "ep2e.time.noEffects"}}</span>
            </div>
            {{/if}}

            {{/if}}
        </div>
        {{/if}}
    </div>

</div>
